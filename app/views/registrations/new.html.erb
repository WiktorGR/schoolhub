<div class="mx-auto max-w-md">
  <h1 class="page-title">Załóż konto</h1>

  <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-5" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "input" %>
    </div>

    <div>
      <%= form.label :email_address, class: "label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "np. anna@example.com", class: "input" %>
    </div>

    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, aria: { describedby: "password_hint" }, class: "input" %>
      <p id="password_hint" class="hint">Co najmniej 8 znaków.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <%= form.submit "Załóż konto", class: "btn-primary w-full sm:w-auto" %>
      <p class="text-sm text-gray-600">Masz już konto? <%= link_to "Zaloguj się", new_session_path, class: "link" %></p>
    </div>
  <% end %>
</div>
