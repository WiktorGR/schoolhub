<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Załóż konto</h1>

  <%= form_with model: @user, url: registration_path, class: "contents" do |form| %>
    <div class="mt-5">
      <%= render "shared/form_errors", record: @user %>
    </div>

    <div class="my-5">
      <%= form.label :email_address, class: "font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "np. anna@example.com", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :password, class: "font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, aria: { describedby: "password_hint" }, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <p id="password_hint" class="mt-1 text-sm text-gray-500">Co najmniej 8 znaków.</p>
    </div>

    <div class="my-5">
      <%= form.label :password_confirmation, class: "font-medium" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit "Załóż konto", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      </div>

      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        Masz już konto? <%= link_to "Zaloguj się", new_session_path, class: "text-gray-700 underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
