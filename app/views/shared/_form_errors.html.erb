<% if record.errors.any? %>
  <div id="error_explanation" role="alert" class="rounded-lg bg-red-50 px-3 py-2 text-red-700">
    <p class="font-medium">Popraw błędy w formularzu:</p>
    <ul class="ml-5 list-disc">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
