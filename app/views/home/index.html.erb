<h1 class="page-title">Cześć, <%= Current.user.name %>!</h1>
<p class="mt-2 text-gray-600">Zalogowano jako <%= Current.user.email_address %>.</p>

<div class="mt-6 grid gap-4 sm:grid-cols-2">
  <%= link_to courses_path, class: "card block hover:border-blue-400" do %>
    <h2 class="font-semibold">Kursy</h2>
    <p class="text-sm text-gray-600">Przeglądaj kursy i grupy.</p>
  <% end %>

  <% if Current.user.admin? %>
    <%= link_to admin_courses_path, class: "card block hover:border-blue-400" do %>
      <h2 class="font-semibold">Zarządzaj kursami</h2>
      <p class="text-sm text-gray-600">Dodawaj kursy, grupy i instruktorów.</p>
    <% end %>
    <%= link_to admin_users_path, class: "card block hover:border-blue-400" do %>
      <h2 class="font-semibold">Użytkownicy</h2>
      <p class="text-sm text-gray-600">Nadawaj role.</p>
    <% end %>
  <% end %>
</div>
