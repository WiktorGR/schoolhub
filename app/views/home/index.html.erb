<div class="mx-auto max-w-md p-4">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-lg" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-lg" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="text-2xl font-bold">Witaj w SchoolHub</h1>
  <p class="mt-2">Zalogowano jako <%= Current.user.email_address %>.</p>

  <%= button_to "Wyloguj", session_path, method: :delete,
        class: "mt-4 rounded-md bg-gray-800 px-4 py-2 text-white" %>
</div>
