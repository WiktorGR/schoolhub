<div class="mx-auto max-w-md">
  <h1 class="page-title">Ustaw nowe hasło</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-5" do |form| %>
    <div>
      <%= form.label :password, "Nowe hasło", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Powtórz nowe hasło", class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Zapisz", class: "btn-primary w-full sm:w-auto" %>
  <% end %>
</div>
