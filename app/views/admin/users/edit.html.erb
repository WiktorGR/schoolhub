<% content_for :title, @user.name %>

<p><%= link_to "← Użytkownicy", admin_users_path, class: "link text-sm" %></p>
<h1 class="page-title mt-2"><%= @user.name %></h1>
<p class="mt-1 text-gray-700"><%= @user.email_address %></p>

<h2 class="mt-6 text-xl font-semibold">Rola</h2>

<%= form_with model: [ :admin, @user ], class: "mt-3 space-y-5" do |form| %>
  <%= render "shared/form_errors", record: @user %>

  <div>
    <%= form.label :role, class: "label" %>
    <%= form.select :role, role_options, {}, class: "input" %>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit "Zapisz", class: "btn-primary" %>
    <%= link_to "Anuluj", admin_users_path, class: "btn-secondary" %>
  </div>
<% end %>

<% if @user.participant? %>
  <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-xl font-semibold">Karnety</h2>
    <%= link_to "Wydaj karnet", new_admin_user_pass_path(@user), class: "btn-primary" %>
  </div>

  <% if @passes.any? %>
    <ul class="mt-3 space-y-3">
      <% @passes.each do |pass| %>
        <li class="card"><%= pass.entries_remaining %> z <%= pass.entries_total %> wejść · wydany <%= l(pass.created_at.to_date, format: :long) %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="card mt-3 text-gray-600">Ten uczestnik nie ma karnetu.</p>
  <% end %>
<% end %>
