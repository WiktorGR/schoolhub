<% content_for :title, @course.name %>

<p><%= link_to "← Wszystkie kursy", admin_courses_path, class: "link text-sm" %></p>

<div class="mt-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="page-title"><%= @course.name %></h1>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Edytuj", edit_admin_course_path(@course), class: "btn-secondary" %>
    <%= button_to "Usuń", admin_course_path(@course), method: :delete, class: "btn-danger",
          form: { data: { turbo_confirm: "Na pewno usunąć ten kurs?" } } %>
  </div>
</div>

<% if @course.description.present? %>
  <p class="mt-3 whitespace-pre-line text-gray-700"><%= @course.description %></p>
<% end %>

<div class="mt-8 flex flex-wrap items-center justify-between gap-3">
  <h2 class="text-xl font-semibold">Grupy</h2>
  <%= link_to "Dodaj grupę", new_admin_course_course_group_path(@course), class: "btn-primary" %>
</div>

<% if @course_groups.any? %>
  <ul class="mt-4 space-y-3">
    <% @course_groups.each do |group| %>
      <li class="card">
        <%= link_to group.name, admin_course_group_path(group), class: "link font-semibold" %>
        <p class="text-sm text-gray-600">Instruktor: <%= group.instructor.name %> · Limit miejsc: <%= group.capacity %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="card mt-4 text-gray-600">Ten kurs nie ma jeszcze grup.</p>
<% end %>
