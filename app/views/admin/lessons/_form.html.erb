<%# locals: (lesson:, series: false) %>
<%= form_with model: lesson, url: lesson.persisted? ? admin_lesson_path(lesson) : admin_course_group_lessons_path(lesson.course_group), class: "mt-6 space-y-5" do |form| %>
  <%= render "shared/form_errors", record: lesson %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :starts_at, class: "label" %>
      <%= form.datetime_field :starts_at, required: true, class: "input" %>
    </div>
    <div>
      <%= form.label :ends_at, class: "label" %>
      <%= form.datetime_field :ends_at, required: true, class: "input" %>
    </div>
  </div>

  <div>
    <%= form.label :topic, class: "label" %>
    <%= form.text_field :topic, maxlength: 200, placeholder: "np. Czas Present Perfect", class: "input" %>
  </div>

  <% if series %>
    <div>
      <%= label_tag :weeks, "Powtarzaj co tydzień przez (liczba tygodni)", class: "label" %>
      <%= number_field_tag :weeks, params.fetch(:weeks, 1), min: 1, max: Lesson::MAX_WEEKS_IN_SERIES, class: "input", aria: { describedby: "weeks_hint" } %>
      <p id="weeks_hint" class="hint">1 oznacza pojedyncze zajęcia. Maksymalnie <%= Lesson::MAX_WEEKS_IN_SERIES %> tygodni.</p>
    </div>
  <% end %>

  <div class="flex flex-wrap gap-3">
    <%= form.submit "Zapisz", class: "btn-primary" %>
    <%= link_to "Anuluj", admin_course_group_path(lesson.course_group), class: "btn-secondary" %>
  </div>
<% end %>
