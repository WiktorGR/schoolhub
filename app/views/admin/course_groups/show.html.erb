<% content_for :title, @course_group.name %>

<p><%= link_to "← #{@course_group.course.name}", admin_course_path(@course_group.course), class: "link text-sm" %></p>

<div class="mt-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="page-title"><%= @course_group.name %></h1>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Edytuj", edit_admin_course_group_path(@course_group), class: "btn-secondary" %>
    <%= button_to "Usuń", admin_course_group_path(@course_group), method: :delete, class: "btn-danger",
          form: { data: { turbo_confirm: "Na pewno usunąć tę grupę?" } } %>
  </div>
</div>

<dl class="card mt-4 grid gap-2 sm:grid-cols-2">
  <div><dt class="text-sm text-gray-500">Instruktor</dt><dd><%= @course_group.instructor.name %></dd></div>
  <div><dt class="text-sm text-gray-500">Limit miejsc</dt><dd><%= @course_group.capacity %></dd></div>
</dl>

<div class="mt-8 grid gap-6 md:grid-cols-2">
  <section>
    <h2 class="text-xl font-semibold">Zapisani (<%= @active_enrollments.size %>/<%= @course_group.capacity %>)</h2>
    <% if @active_enrollments.any? %>
      <ol class="card mt-3 list-decimal space-y-1 pl-8">
        <% @active_enrollments.each do |enrollment| %>
          <li><%= enrollment.user.name %> <span class="text-sm text-gray-500"><%= enrollment.user.email_address %></span></li>
        <% end %>
      </ol>
    <% else %>
      <p class="card mt-3 text-gray-600">Nikt się jeszcze nie zapisał.</p>
    <% end %>
  </section>

  <section>
    <h2 class="text-xl font-semibold">Lista rezerwowa (<%= @waitlisted_enrollments.size %>)</h2>
    <% if @waitlisted_enrollments.any? %>
      <ol class="card mt-3 list-decimal space-y-1 pl-8">
        <% @waitlisted_enrollments.each do |enrollment| %>
          <li><%= enrollment.user.name %> <span class="text-sm text-gray-500"><%= enrollment.user.email_address %></span></li>
        <% end %>
      </ol>
    <% else %>
      <p class="card mt-3 text-gray-600">Lista rezerwowa jest pusta.</p>
    <% end %>
  </section>
</div>

<div class="mt-8 flex flex-wrap items-center justify-between gap-3">
  <h2 class="text-xl font-semibold">Nadchodzące zajęcia</h2>
  <%= link_to "Dodaj zajęcia", new_admin_course_group_lesson_path(@course_group), class: "btn-primary" %>
</div>

<% if @lessons.any? %>
  <ul class="mt-4 space-y-3">
    <% @lessons.each do |lesson| %>
      <li class="card flex flex-wrap items-center justify-between gap-3" id="<%= dom_id(lesson) %>">
        <div>
          <p class="font-semibold"><%= l(lesson.starts_at.to_date, format: :day_heading) %>, <%= l(lesson.starts_at, format: :hour) %>–<%= l(lesson.ends_at, format: :hour) %></p>
          <% if lesson.topic.present? %><p class="text-sm text-gray-600"><%= lesson.topic %></p><% end %>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to "Obecność", edit_lesson_attendance_path(lesson), class: "btn-secondary" %>
          <%= link_to "Edytuj", edit_admin_lesson_path(lesson), class: "btn-secondary" %>
          <%= button_to "Usuń", admin_lesson_path(lesson), method: :delete, class: "btn-danger",
                form: { data: { turbo_confirm: "Na pewno usunąć te zajęcia?" } } %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="card mt-4 text-gray-600">Brak zaplanowanych zajęć.</p>
<% end %>
