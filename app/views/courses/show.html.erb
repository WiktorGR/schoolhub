<% content_for :title, @course.name %>

<p><%= link_to "← Wszystkie kursy", courses_path, class: "link text-sm" %></p>
<h1 class="page-title mt-2"><%= @course.name %></h1>

<% if @course.description.present? %>
  <p class="mt-3 whitespace-pre-line text-gray-700"><%= @course.description %></p>
<% end %>

<h2 class="mt-8 text-xl font-semibold">Grupy</h2>

<% if @course_groups.any? %>
  <ul class="mt-4 space-y-3">
    <% @course_groups.each do |group| %>
      <li class="card" id="<%= dom_id(group) %>">
        <h3 class="font-semibold"><%= group.name %></h3>
        <p class="text-sm text-gray-600">Instruktor: <%= group.instructor.name %> · Limit miejsc: <%= group.capacity %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="card mt-4 text-gray-600">Ten kurs nie ma jeszcze grup.</p>
<% end %>
